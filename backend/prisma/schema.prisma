generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  ACTIVE
  INACTIVE
  LOCKED
  PENDING
}

enum ClaimStatus {
  SUBMITTED
  CASE_ASSIGNED
  SURVEY_PENDING
  SURVEY_COMPLETED
  ADJUDICATION_PENDING
  APPROVED
  REJECTED
  REPAIR_IN_PROGRESS
  REPAIR_COMPLETED
  PAYMENT_PENDING
  CLOSED
}

enum AppointmentStatus {
  SCHEDULED
  CONFIRMED
  COMPLETED
  CANCELLED
}

enum SurveyStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
}

enum RepairStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
}

model Role {
  id          String  @id @default(uuid())
  name        String  @unique
  description String?
  isActive    Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  permissions RolePermission[]
  users       User[]
}

model Permission {
  id          String  @id @default(uuid())
  name        String  @unique
  module      String
  action      String
  description String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  roles RolePermission[]
}

model RolePermission {
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model User {
  id        String  @id @default(uuid())
  firstName String
  lastName  String
  email     String  @unique
  password  String
  phone     String?

  roleId String
  role   Role   @relation(fields: [roleId], references: [id])

  status UserStatus @default(ACTIVE)

  lastLogin DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  claims                 Claim[]
  surveys                Survey[]
  caseManagerAssignments CaseAssignment[] @relation("CaseManagerAssignments")
  surveyorAssignments    CaseAssignment[] @relation("SurveyorAssignments")
  adjudications          Adjudication[]   @relation("AdjusterAdjudications")
}

model Claim {
  id          String @id @default(uuid())
  claimNumber String @unique

  customerId String
  customer   User   @relation(fields: [customerId], references: [id])

  title       String
  description String

  incidentDate     DateTime
  incidentLocation String

  status ClaimStatus @default(SUBMITTED)

  workshopId String?
  workshop   Workshop? @relation(fields: [workshopId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  documents      Document[]
  appointment    Appointment?
  survey         Survey?
  caseAssignment CaseAssignment?
  adjudication   Adjudication?
  repair         Repair?
  payment        Payment?
}

model Document {
  id String @id @default(uuid())

  fileName     String
  originalName String
  mimeType     String
  fileSize     Int
  filePath     String

  claimId String
  claim   Claim  @relation(fields: [claimId], references: [id], onDelete: Cascade)

  uploadedAt DateTime @default(now())
}

model Workshop {
  id          String  @id @default(cuid())
  name        String  @unique
  address     String
  city        String
  state       String
  phoneNumber String
  email       String?
  isActive    Boolean @default(true)

  claims       Claim[]
  appointments Appointment[]
  repairs      Repair[]
}

model Appointment {
  id String @id @default(cuid())

  appointmentDate DateTime

  status AppointmentStatus @default(SCHEDULED)

  claimId String @unique
  claim   Claim  @relation(fields: [claimId], references: [id])

  workshopId String
  workshop   Workshop @relation(fields: [workshopId], references: [id])

  createdAt DateTime @default(now())
}

model Survey {
  id String @id @default(cuid())

  claimId String @unique
  claim   Claim  @relation(fields: [claimId], references: [id])

  surveyorId String
  surveyor   User   @relation(fields: [surveyorId], references: [id])

  damageDescription String

  estimatedCost Float?

  reportPath String?

  status SurveyStatus @default(PENDING)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Adjudication {
  id             String      @id @default(cuid())
  claimId        String      @unique
  adjusterId     String
  decision       ClaimStatus
  approvedAmount Float?
  decisionReason String
  decidedAt      DateTime    @default(now())
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  claim    Claim @relation(fields: [claimId], references: [id], onDelete: Cascade)
  adjuster User  @relation("AdjusterAdjudications", fields: [adjusterId], references: [id])

  @@index([adjusterId])
}

model CaseAssignment {
  id            String   @id @default(cuid())
  claimId       String   @unique
  caseManagerId String
  surveyorId    String?
  assignedAt    DateTime @default(now())
  updatedAt     DateTime @updatedAt

  claim       Claim @relation(fields: [claimId], references: [id], onDelete: Cascade)
  caseManager User  @relation("CaseManagerAssignments", fields: [caseManagerId], references: [id])
  surveyor    User? @relation("SurveyorAssignments", fields: [surveyorId], references: [id])

  @@index([caseManagerId])
  @@index([surveyorId])
}

model Repair {
  id                   String       @id @default(cuid())
  claimId              String       @unique
  workshopId           String
  status               RepairStatus @default(NOT_STARTED)
  expectedDeliveryDate DateTime?
  startedAt            DateTime?
  completedAt          DateTime?
  finalBillAmount      Float?
  repairNotes          String?
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt

  claim    Claim    @relation(fields: [claimId], references: [id], onDelete: Cascade)
  workshop Workshop @relation(fields: [workshopId], references: [id])

  @@index([workshopId])
  @@index([status])
}

model Payment {
  id                  String        @id @default(cuid())
  claimId             String        @unique
  amount              Float
  paymentMethod       String
  status              PaymentStatus @default(PENDING)
  transactionReference String?
  paidAt              DateTime?
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  claim Claim @relation(fields: [claimId], references: [id], onDelete: Cascade)

  @@index([status])
} 
